# ── AI Payment Platform — environment ────────────────────────────────────
# Copy this file to .env and fill in real keys:
#
#   cp .env.example .env
#
# The gateway starts in demo mode for any empty value. Set a key to enable
# the real integration. Nothing is hardcoded in the source anymore.

# ── Database (Supabase on Docker, or cloud) ──────────────────────────────
# Local (start with: docker compose up -d db):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Supabase cloud (Project Settings → Database → Connection string) looks like:
# DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Security ─────────────────────────────────────────────────────────────
# JWT secret for user session tokens (HS256). MUST be at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long

# ── AI providers (leave empty to use mock responses) ─────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Stripe (leave empty to use demo webhook handling) ────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
