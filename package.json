{
  "name": "ai-payment-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "test": "bun test",
    "typecheck": "tsc --build",
    "server": "bun run packages/server/src/server.ts",
    "playground": "bun run scripts/playground.ts",
    "demo": "bun --filter demo-app dev",
    "dashboard": "bun --filter dashboard dev",
    "docs": "bun --filter docs dev",
    "landing": "bun --filter landing dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "bun-types": "^1.4.0",
    "hono": "^4.13.5"
  }
}
