{
  "name": "ai-credits",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "test": "bun test",
    "typecheck": "tsc --build",
    "server": "bun --env-file=.env run packages/server/src/server.ts",
    "playground": "bun run scripts/playground.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:migrate": "bun --env-file=.env run scripts/migrate.ts",
    "db:migrate:prod": "bun run scripts/migrate.ts",
    "cleanup": "bun --env-file=.env run scripts/cleanup.ts",
    "demo": "bun --filter demo-app dev",
    "dashboard": "bun --filter dashboard dev",
    "docs": "bun --filter docs dev",
    "landing": "bun --filter landing dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "bun-types": "^1.4.0",
    "hono": "^4.13.5",
    "postgres": "^3.4.9"
  }
}
